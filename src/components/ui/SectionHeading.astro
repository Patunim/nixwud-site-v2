---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<header class:list={["section-heading", { "section-heading--center": align === "center" }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="lede">{description}</p>}
</header>

<style>
  .section-heading {
    max-width: 54rem;
    margin-bottom: 3.5rem;
  }

  .section-heading h2 {
    max-width: 25ch;
    margin-bottom: 1.25rem;
  }

  .section-heading .lede {
    max-width: 44rem;
    margin-bottom: 0;
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading--center h2 {
    margin-inline: auto;
  }

  .section-heading--center .eyebrow {
    justify-content: center;
  }

  .section-heading--center .lede {
    margin-inline: auto;
  }

  @media (max-width: 700px) {
    .section-heading {
      margin-bottom: 2.5rem;
    }

    .section-heading h2 {
      max-width: none;
    }
  }
</style>

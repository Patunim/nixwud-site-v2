---
import Button from "../ui/Button.astro";
---

<section class="hero">
  <div class="container--wide hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Business & Technology Consultancy</p>
      <h1>Better technology decisions begin with understanding your business.</h1>
      <p class="lede">Nixwud Consultancy helps organizations connect strategy, systems and execution so technology creates measurable business value.</p>
      <div class="button-row">
        <Button href="/contact" variant="primary">Discuss your priorities</Button>
        <Button href="/insights" variant="secondary">Explore our thinking</Button>
      </div>
    </div>

    <aside class="hero__framework" aria-label="Nixwud decision framework">
      <p class="kicker">A clearer decision path</p>
      <ol>
        <li><span>01</span><strong>Understand</strong><small>Context before assumptions</small></li>
        <li><span>02</span><strong>Align</strong><small>Priorities before projects</small></li>
        <li><span>03</span><strong>Decide</strong><small>Evidence before investment</small></li>
        <li><span>04</span><strong>Deliver</strong><small>Outcomes before output</small></li>
      </ol>
    </aside>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 4.8rem);
    display: grid;
    align-items: center;
    padding-block: clamp(5.5rem, 10vw, 9rem);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(17rem, 0.65fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: end;
  }

  .hero__copy {
    max-width: 56rem;
  }

  .hero__copy h1 {
    max-width: 13ch;
    margin-bottom: 1.75rem;
  }

  .hero__copy .lede {
    max-width: 43rem;
    margin-bottom: 2rem;
  }

  .hero__framework {
    align-self: end;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .hero__framework .kicker {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .hero__framework ol {
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0;
  }

  .hero__framework li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .hero__framework li:last-child {
    padding-bottom: 0;
  }

  .hero__framework span {
    grid-row: span 2;
    color: var(--accent-soft);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .hero__framework strong {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hero__framework small {
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-block: 5rem;
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero__copy h1 {
      max-width: 15ch;
    }

    .hero__framework {
      max-width: 34rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-block: 4rem;
    }

    .hero__copy h1 {
      max-width: none;
    }

    .hero__framework {
      padding: 1.2rem;
    }
  }
</style>
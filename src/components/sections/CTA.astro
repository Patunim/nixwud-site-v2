---
import Button from "../ui/Button.astro";
interface Props { title?: string; description?: string; }
const {
  title = "A better decision can change more than a technology project.",
  description = "Tell us what your organization is trying to improve. We will help you clarify the next useful step."
} = Astro.props;
---

<section class="cta-section section border-top">
  <div class="container cta-section__inner">
    <div>
      <p class="eyebrow">Start with the problem</p>
      <h2>{title}</h2>
      <p class="lede">{description}</p>
    </div>
    <Button href="/contact" variant="primary">Start a conversation</Button>
  </div>
</section>

<style>
  .cta-section__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 3rem; align-items: end; }
  .cta-section h2 { max-width: 55rem; margin-bottom: 1.2rem; }
  .cta-section .lede { margin-bottom: 0; }
  @media (max-width: 760px) { .cta-section__inner { grid-template-columns: 1fr; align-items: start; } }
</style>

---
import Button from "../ui/Button.astro";
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  buttonText?: string;
}
const {
  eyebrow = "Start with the problem",
  title = "Have something that needs building?",
  description = "Tell us what your organisation is trying to achieve. We first work out what actually needs building, then design and engineer the solution.",
  buttonText = "Talk to Nixwud"
} = Astro.props;
---

<section class="cta-section section border-top">
  <div class="container cta-section__inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="lede">{description}</p>
    </div>
    <Button href="/contact" variant="primary">{buttonText}</Button>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(6rem, 11vw, 10rem);
  }

  .cta-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .cta-section h2 {
    max-width: 18ch;
    margin-bottom: 1.25rem;
  }

  .cta-section .lede {
    max-width: 38rem;
    margin-bottom: 0;
  }

  .cta-section__inner > .button {
    margin-bottom: 0.2rem;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .cta-section {
      padding-block: 5rem;
    }

    .cta-section__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }

    .cta-section h2 {
      max-width: none;
    }

    .cta-section__inner > .button {
      width: fit-content;
    }
  }
</style>

---
import SectionHeading from "../ui/SectionHeading.astro";
const steps = [
  { number: "01", title: "Understand", text: "Clarify the business context, constraints, stakeholders and evidence." },
  { number: "02", title: "Frame", text: "Define the actual problem and the criteria a useful solution must satisfy." },
  { number: "03", title: "Decide", text: "Compare options, trade-offs and expected value before committing resources." },
  { number: "04", title: "Deliver", text: "Implement in measurable stages, learn from evidence and improve deliberately." }
];
---

<section class="section section--paper">
  <div class="container--wide">
    <SectionHeading eyebrow="How we work" title="Think before building." description="Our method is designed to reduce uncertainty before it becomes expensive complexity." />
    <ol class="method grid grid--4">
      {steps.map((step) => (
        <li>
          <span>{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .method li {
    min-width: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-dark);
  }

  .method span {
    display: block;
    color: #3554d8;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .method h3 {
    margin: 3.25rem 0 0.75rem;
    font-size: clamp(1.25rem, 1.5vw, 1.5rem);
  }

  .method p {
    max-width: 18rem;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .method {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .method {
      grid-template-columns: 1fr;
      row-gap: 2.5rem;
    }

    .method h3 {
      margin-top: 2rem;
    }

    .method p {
      max-width: 32rem;
    }
  }
</style>
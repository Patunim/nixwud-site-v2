---
import SectionHeading from "../ui/SectionHeading.astro";

const steps = [
  {
    number: "01",
    title: "Understand",
    kicker: "Diagnostic Stage",
    text: "Clarify the business context, constraints, stakeholders and underlying evidence.",
    role: "start"
  },
  {
    number: "02",
    title: "Frame",
    kicker: "Alignment Stage",
    text: "Define the actual problem and the criteria a useful solution must satisfy.",
    role: "align"
  },
  {
    number: "03",
    title: "Decide",
    kicker: "Decision Gate",
    text: "Compare options, trade-offs and expected value before committing resources.",
    role: "gate",
    isGate: true
  },
  {
    number: "04",
    title: "Deliver",
    kicker: "Execution Stage",
    text: "Implement in measurable stages, learn from evidence and improve deliberately.",
    role: "destination",
    isDestination: true
  }
];
---

<section class="section section--paper methodology-section" id="methodology">
  <div class="container--wide">
    <SectionHeading
      eyebrow="How we work"
      title="Think before building."
      description="Our method is designed to reduce uncertainty before it becomes expensive complexity."
    />

    <!-- Signature Visual Decision Path -->
    <div class="decision-path" aria-label="Consulting Decision Path">
      <!-- Desktop Continuous Architectural Path -->
      <svg class="decision-path__svg" viewBox="0 0 1200 240" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M 60,170 C 220,170 240,110 400,110 C 560,110 600,60 760,60 C 920,60 960,130 1140,130"
          stroke="currentColor"
          stroke-width="2"
          stroke-dasharray="4 4"
          class="path-line-dash"
        />
        <path
          d="M 60,170 C 220,170 240,110 400,110 C 560,110 600,60 760,60 C 920,60 960,130 1140,130"
          stroke="var(--accent)"
          stroke-width="2"
          class="path-line-accent"
        />
      </svg>

      <ol class="decision-stages list-clean">
        {steps.map((step) => (
          <li class:list={["decision-stage", `decision-stage--${step.role}`, { "decision-stage--gate": step.isGate, "decision-stage--dest": step.isDestination }]}>
            <!-- Background Editorial Display Numeral -->
            <span class="stage-watermark" aria-hidden="true">{step.number}</span>

            <div class="stage-node-wrap">
              <div class="stage-node">
                <span class="stage-node__dot"></span>
                <span class="stage-node__num">{step.number}</span>
              </div>
              {step.isGate && <span class="stage-gate-badge" aria-hidden="true">KEY GATE</span>}
              {step.isDestination && <span class="stage-dest-badge" aria-hidden="true">OUTCOME</span>}
            </div>

            <div class="stage-body">
              <span class="stage-kicker">{step.kicker}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .methodology-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 8rem);
  }

  .decision-path {
    position: relative;
    margin-top: clamp(3rem, 6vw, 5rem);
    min-height: 28rem;
  }

  .decision-path__svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: var(--line-dark);
    pointer-events: none;
    z-index: 1;
  }

  .path-line-accent {
    opacity: 0.75;
    transition: stroke-dashoffset var(--transition-editorial);
  }

  .decision-stages {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.5vw, 2.5rem);
    z-index: 2;
  }

  .decision-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius-md);
    background: rgba(243, 241, 235, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line-dark);
    transition: transform var(--transition-standard), border-color var(--transition-standard), box-shadow var(--transition-standard);
  }

  .decision-stage:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: var(--paper);
    box-shadow: var(--shadow-sm);
  }

  /* Asymmetric Vertical Stagger along the Decision Path */
  .decision-stage--start {
    margin-top: 6.5rem;
  }

  .decision-stage--align {
    margin-top: 3rem;
  }

  .decision-stage--gate {
    margin-top: 0;
    border-color: rgba(83, 109, 206, 0.4);
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 0 4px 20px rgba(83, 109, 206, 0.08);
  }

  .decision-stage--gate .stage-node {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(83, 109, 206, 0.15);
  }

  .decision-stage--dest {
    margin-top: 4.5rem;
    border-left: 3px solid var(--accent);
  }

  /* Oversized Background Editorial Numerals */
  .stage-watermark {
    position: absolute;
    top: -0.5rem;
    right: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 5vw, 5rem);
    font-weight: 700;
    color: var(--paper-muted);
    line-height: 1;
    letter-spacing: -0.04em;
    user-select: none;
    pointer-events: none;
    z-index: -1;
  }

  .stage-node-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .stage-node {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.65rem;
    background: var(--paper);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-pill);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .stage-node__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .stage-node__num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }

  .stage-gate-badge {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--paper);
    background: var(--accent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  .stage-dest-badge {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: rgba(83, 109, 206, 0.12);
    border: 1px solid rgba(83, 109, 206, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  .stage-kicker {
    display: block;
    color: var(--accent);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .stage-body h3 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.2rem, 1.4vw, 1.45rem);
    color: var(--ink);
    line-height: 1.25;
  }

  .stage-body p {
    margin: 0;
    color: var(--text-dark-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .decision-path__svg {
      display: none;
    }

    .decision-stages {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .decision-stage--start,
    .decision-stage--align,
    .decision-stage--gate,
    .decision-stage--dest {
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .decision-stages {
      grid-template-columns: 1fr;
      position: relative;
      padding-left: 1.5rem;
      border-left: 2px dashed rgba(83, 109, 206, 0.3);
    }

    .decision-stage {
      padding: 1.5rem 1.25rem;
    }

    .decision-stage::before {
      content: "";
      position: absolute;
      left: -1.85rem;
      top: 2rem;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      border: 2px solid var(--paper);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .decision-stage {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
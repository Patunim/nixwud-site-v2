---
import Brand from "./Brand.astro";
import { navigation } from "../../lib/siteConfig.js";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" data-header>
  <nav class="nav container--wide" aria-label="Primary navigation">
    <a class="nav__brand" href="/" aria-label="Nixwud Consultancy home"><Brand /></a>

    <div class="nav__desktop">
      {navigation.map((item) => (
        item.children && item.children.length > 0 ? (
          <div class="nav__dropdown-group">
            <a
              href={item.href}
              class="nav__link nav__link--has-dropdown"
              aria-current={isActive(item.href) ? "page" : undefined}
              aria-haspopup="true"
            >
              <span>{item.label}</span>
              <svg class="nav__chevron" width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true">
                <path d="M1 1.25L4.5 4.75L8 1.25" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="nav__dropdown" role="menu" aria-label={`${item.label} sub-navigation`}>
              {item.children.map((child) => (
                <a
                  href={child.href}
                  role="menuitem"
                  class="nav__dropdown-item"
                  aria-current={path === child.href ? "page" : undefined}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        )
      ))}
    </div>

    <a class="button button--primary nav__cta" href="/contact">Start a conversation</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Open navigation" data-menu-toggle>
      <span></span><span></span>
    </button>
  </nav>

  <div id="mobile-navigation" class="mobile-nav" hidden data-mobile-menu>
    <div class="container--wide mobile-nav__inner">
      {navigation.map((item) => (
        item.children && item.children.length > 0 ? (
          <div class="mobile-nav__group">
            <a href={item.href} class="mobile-nav__parent" aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
            <div class="mobile-nav__children">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="mobile-nav__child"
                  aria-current={path === child.href ? "page" : undefined}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        )
      ))}
      <a class="button button--accent" href="/contact">Start a conversation</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const closeMenu = (restoreFocus = false) => {
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open navigation");
    menu.hidden = true;
    document.body.classList.remove("menu-open");
    if (restoreFocus) toggle.focus();
  };
  toggle?.addEventListener("click", () => {
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open navigation" : "Close navigation");
    menu.hidden = open;
    document.body.classList.toggle("menu-open", !open);
    if (!open) requestAnimationFrame(() => menu.querySelector<HTMLElement>("a")?.focus());
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu instanceof HTMLElement && !menu.hidden) closeMenu(true);
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 960) closeMenu(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(9, 11, 15, 0.92);
    backdrop-filter: blur(14px);
  }

  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    min-height: 4.5rem;
    gap: 2rem;
  }

  .nav__desktop {
    display: flex;
    justify-content: center;
    align-items: stretch;
    height: 100%;
    gap: clamp(1.1rem, 2vw, 1.75rem);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 100%;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color var(--transition);
  }

  .nav__link:hover,
  .nav__link[aria-current="page"] {
    color: var(--text);
  }

  /* Desktop dropdown */

  .nav__dropdown-group {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
  }

  .nav__chevron {
    transition: transform var(--transition);
    opacity: 0.55;
  }

  .nav__dropdown-group:hover .nav__chevron,
  .nav__dropdown-group:focus-within .nav__chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  .nav__dropdown {
    position: absolute;
    top: calc(100% - 0.15rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 15rem;
    padding: 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--ink-soft);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--transition), visibility var(--transition);
    z-index: 60;
  }

  .nav__dropdown::before {
    content: "";
    position: absolute;
    top: -0.65rem;
    left: 0;
    right: 0;
    height: 0.65rem;
  }

  .nav__dropdown-group:hover .nav__dropdown,
  .nav__dropdown-group:focus-within .nav__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav__dropdown-item {
    display: block;
    padding: 0.65rem 0.8rem;
    border-radius: 0.4rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color var(--transition), background var(--transition);
  }

  .nav__dropdown-item:hover,
  .nav__dropdown-item:focus-visible,
  .nav__dropdown-item[aria-current="page"] {
    color: var(--text);
    background: rgba(255, 255, 255, 0.045);
  }

  /* Mobile trigger */

  .nav__toggle {
    display: none;
    width: 2.7rem;
    height: 2.7rem;
    padding: 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
  }

  .nav__toggle span {
    display: block;
    height: 1px;
    background: currentColor;
  }

  .nav__toggle span + span {
    margin-top: 0.5rem;
  }

  /* Mobile navigation */

  .mobile-nav {
    position: fixed;
    inset: 4.5rem 0 0;
    background: var(--ink);
    overflow-y: auto;
    z-index: 49;
  }

  .mobile-nav__inner {
    display: grid;
    gap: 0;
    padding-block: 1rem 3rem;
  }

  .mobile-nav__inner > a:not(.button) {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .mobile-nav__group {
    padding-block: 1rem 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav__parent {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .mobile-nav__children {
    display: grid;
    gap: 0.25rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line);
    margin-left: 0.15rem;
  }

  .mobile-nav__child {
    display: block;
    padding: 0.4rem 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .mobile-nav__child:hover,
  .mobile-nav__child[aria-current="page"] {
    color: var(--accent-soft);
  }

  .mobile-nav__inner .button {
    margin-top: 2rem;
  }

  @media (max-width: 960px) {
    .nav {
      grid-template-columns: auto 1fr auto;
    }

    .nav__desktop,
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: block;
      grid-column: 3;
    }
  }
</style>
---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<span class:list={["brand", { "brand--compact": compact }]} aria-label="Nixwud Consultancy">
  <span class="brand__mark" aria-hidden="true">N</span>
  {!compact && (
    <span class="brand__name">
      <strong>Nixwud</strong>
      <small>Consultancy</small>
    </span>
  )}
</span>

<style>
  .brand { display: inline-flex; align-items: center; gap: .72rem; }
  .brand__mark {
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem;
    border: 1px solid rgba(255,255,255,.35); border-radius: .45rem;
    font-weight: 800; letter-spacing: -.06em;
  }
  .brand__name { display: grid; line-height: 1; }
  .brand__name strong { font-size: 1.02rem; letter-spacing: -.02em; }
  .brand__name small { margin-top: .24rem; color: var(--text-muted); font-size: .54rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .brand--compact .brand__mark { width: 2.35rem; height: 2.35rem; }
</style>

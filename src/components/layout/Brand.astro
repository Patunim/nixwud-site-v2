---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<span class:list={["brand", { "brand--compact": compact }]} aria-label="Nixwud Consultancy">
  <span class="brand__mark" aria-hidden="true">N</span>
  {!compact && (
    <span class="brand__name">
      <strong>Nixwud</strong>
      <small>Consultancy</small>
    </span>
  )}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 0.4rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .brand__name {
    display: grid;
    line-height: 1;
  }

  .brand__name strong {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .brand__name small {
    margin-top: 0.25rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .brand--compact .brand__mark {
    width: 2.3rem;
    height: 2.3rem;
  }
</style>
---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={["brand", { "brand--compact": compact }]} aria-label="Nixwud Consultancy">
  <img
    src="/brand/nixwud-logo.png"
    alt="Nixwud Consultancy"
    width="58"
    height="58"
    class="brand__logo-img"
    loading="eager"
    decoding="async"
  />
  {!compact && (
    <span class="brand__name">
      <strong>Nixwud</strong>
      <small>Consultancy</small>
    </span>
  )}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.95rem;
    text-decoration: none;
  }

  .brand__logo-img {
    display: block;
    width: 3.4rem;
    height: 3.4rem;
    object-fit: cover;
    border-radius: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
    transition: transform var(--transition-base, 0.2s ease), border-color var(--transition-base, 0.2s ease), box-shadow var(--transition-base, 0.2s ease);
  }

  .brand:hover .brand__logo-img {
    transform: translateY(-1px);
    border-color: var(--accent, #617dff);
    box-shadow: 0 0 16px rgba(97, 125, 255, 0.32);
  }

  .brand__name {
    display: grid;
    line-height: 1.05;
  }

  .brand__name strong {
    color: var(--text, #f4f3ef);
    font-family: var(--font-display, "Inter", sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .brand__name small {
    margin-top: 0.3rem;
    color: var(--text-muted, #aeb5c0);
    font-family: var(--font-body, "IBM Plex Sans", sans-serif);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .brand--compact .brand__logo-img {
    width: 3.75rem;
    height: 3.75rem;
  }
</style>
---
import Brand from "./Brand.astro";
import { CONTACT_EMAIL, navigation, services } from "../../lib/siteConfig.js";
---

<footer class="footer border-top">
  <div class="container--wide footer__manifesto">
    <span class="footer__manifesto-tag">Design - Development - Business Systems</span>
    <h2 class="footer__manifesto-title">Think clearly. Build deliberately.</h2>
  </div>

  <div class="container--wide footer__top">
    <div class="footer__intro">
      <a href="/" aria-label="Nixwud home"><Brand /></a>
      <p>We design and build websites, web applications and business systems that help organisations work better and grow.</p>
    </div>
    <div>
      <p class="footer__label">Capabilities</p>
      <ul class="list-clean footer__links">
        {services.map((service) => (
          <li><a href={`/services/${service.slug}`}>{service.title}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="footer__label">Explore</p>
      <ul class="list-clean footer__links">
        <li><a href="/case-studies">Work</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/insights">Insights</a></li>
        <li><a href="/resources">Resources</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__label">Contact</p>
      <ul class="list-clean footer__links">
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a href="/contact">Start a project</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
      </ul>
    </div>
  </div>
  <div class="container--wide footer__bottom">
    <p>© {new Date().getFullYear()} Nixwud. All rights reserved.</p>
    <div>
      <a href="/privacy-policy">Privacy</a>
      <button class="footer__text-button" id="analytics-preferences" type="button">Cookie settings</button>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(4.5rem, 8vw, 7rem);
  }

  .footer__manifesto {
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .footer__manifesto-tag {
    display: inline-block;
    color: var(--accent-soft);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .footer__manifesto-title {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    font-weight: 600;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--text);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(11rem, 1fr) minmax(8rem, 0.65fr) minmax(11rem, 0.85fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: 4rem;
  }

  .footer__intro p {
    max-width: 22rem;
    margin: 1.5rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer__label {
    margin-bottom: 1.25rem;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__links {
    display: grid;
    gap: 0.7rem;
  }

  .footer__links a {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 400;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer__links a:hover {
    color: var(--text);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__bottom div {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer__bottom a,
  .footer__text-button {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer__text-button {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .footer__bottom a:hover,
  .footer__text-button:hover {
    color: var(--text);
  }

  @media (max-width: 960px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
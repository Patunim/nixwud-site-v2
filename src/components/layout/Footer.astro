---
import Brand from "./Brand.astro";
import { CONTACT_EMAIL, navigation } from "../../lib/siteConfig.js";
---

<footer class="footer border-top">
  <div class="container--wide footer__top">
    <div class="footer__intro">
      <a href="/" aria-label="Nixwud Consultancy home"><Brand /></a>
      <p>Business judgement supported by technology.</p>
    </div>
    <div>
      <p class="footer__label">Explore</p>
      <ul class="list-clean footer__links">
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="footer__label">Contact</p>
      <ul class="list-clean footer__links">
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a href="/contact">Start a conversation</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
      </ul>
    </div>
  </div>
  <div class="container--wide footer__bottom">
    <p>© {new Date().getFullYear()} Nixwud Consultancy. All rights reserved.</p>
    <div><a href="/privacy-policy">Privacy</a><a href="/terms">Terms</a></div>
  </div>
</footer>

<style>
  .footer { padding-top: 4.5rem; }
  .footer__top { display: grid; grid-template-columns: 1.4fr .7fr 1fr; gap: 3rem; padding-bottom: 3.5rem; }
  .footer__intro p { max-width: 22rem; margin-top: 1.2rem; }
  .footer__label { color: var(--text); font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .footer__links { display: grid; gap: .6rem; }
  .footer__links a { color: var(--text-muted); }
  .footer__links a:hover { color: var(--text); }
  .footer__bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; border-top: 1px solid var(--line); font-size: .82rem; }
  .footer__bottom p { margin: 0; }
  .footer__bottom div { display: flex; gap: 1.25rem; }
  @media (max-width: 760px) { .footer__top { grid-template-columns: 1fr; } .footer__bottom { flex-direction: column; } }
</style>

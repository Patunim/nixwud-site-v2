---
interface Props {
  insight: { title: string; slug: string; excerpt?: string; publishedAt?: string; categories?: string[] };
}
const { insight } = Astro.props;
const date = insight.publishedAt ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" }).format(new Date(insight.publishedAt)) : "Insight";
---

<article class="card insight-card">
  <div class="insight-card__meta"><span>{insight.categories?.[0] || "Strategic Insight"}</span><span>{date}</span></div>
  <h3><a href={`/insights/${insight.slug}`}>{insight.title}</a></h3>
  <p>{insight.excerpt || "A practical perspective to support clearer business and technology decisions."}</p>
  <a class="card__link" href={`/insights/${insight.slug}`}>Read the insight</a>
</article>

<style>
  .insight-card { display: flex; flex-direction: column; min-height: 20rem; }
  .insight-card__meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--text-muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .insight-card h3 { margin: 2rem 0 1rem; }
  .insight-card .card__link { margin-top: auto; }
</style>

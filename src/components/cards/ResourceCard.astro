---
interface Props {
  resource: { type: string; title: string; description: string; href: string; action: string; featured?: boolean };
}
const { resource } = Astro.props;
---

<article class:list={["card resource-card", { "resource-card--featured": resource.featured }]}>
  <span class="kicker">{resource.type}</span>
  <h3>{resource.title}</h3>
  <p>{resource.description}</p>
  <a class="card__link" href={resource.href}>{resource.action}</a>
</article>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .resource-card .kicker {
    color: var(--accent-soft);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resource-card h3 {
    max-width: 18ch;
    margin: 2.75rem 0 1rem;
  }

  .resource-card p {
    max-width: 30rem;
    margin-bottom: 0;
  }

  .resource-card .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    margin-top: auto;
    padding-top: 2rem;
  }

  .resource-card .card__link::after {
    content: "↗";
    font-size: 0.9em;
    transition: transform var(--transition);
  }

  .resource-card .card__link:hover::after {
    transform: translate(2px, -2px);
  }

  .resource-card--featured {
    border-color: var(--accent);
  }

  @media (max-width: 600px) {
    .resource-card {
      min-height: auto;
    }

    .resource-card h3 {
      max-width: none;
      margin-top: 2rem;
    }

    .resource-card .card__link {
      padding-top: 1.5rem;
    }
  }
</style>

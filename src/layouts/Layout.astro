---
import "../styles/global.css";
import Navigation from "../components/layout/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import { CONTACT_EMAIL, SITE_DESCRIPTION, SITE_NAME, SITE_URL, SOCIAL_LINKS } from "../lib/siteConfig.js";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-default.png",
  canonical,
  type = "website",
  publishedTime,
  noindex = false
} = Astro.props;

const siteName = SITE_NAME;
const baseUrl = SITE_URL;
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} — Business & Technology Consultancy`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, baseUrl).toString();
const resolvedImage = typeof image === "string" && image.trim() ? image : "/og-default.png";
const imageUrl = /^https?:\/\//i.test(resolvedImage) ? resolvedImage : new URL(resolvedImage, baseUrl).toString();
const maintenanceMode = import.meta.env.PUBLIC_MAINTENANCE_MODE === "true";
const configuredAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || "G-7RY15GCJ1Z";
const analyticsId = /^G-[A-Z0-9]+$/i.test(configuredAnalyticsId) ? configuredAnalyticsId : undefined;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const logoUrl = new URL("/favicon.svg", baseUrl).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: baseUrl,
  logo: logoUrl,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  sameAs: SOCIAL_LINKS,
  knowsAbout: ["Business strategy", "Business analysis", "Technology consulting", "Digital platforms", "AI readiness", "Automation", "SEO", "Generative engine optimization"]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(noindex || maintenanceMode) && <meta name="robots" content="noindex, nofollow" />}
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>

    {analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {analyticsId && (
      <script is:inline define:vars={{ analyticsId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", analyticsId);
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {maintenanceMode ? (
      <main id="main-content" class="maintenance">
        <div class="container--narrow">
          <p class="eyebrow">Nixwud Consultancy</p>
          <h1>We are refining the experience.</h1>
          <p class="lede">The website will be available again shortly.</p>
        </div>
      </main>
    ) : (
      <>
        <Navigation />
        <main id="main-content"><slot /></main>
        <Footer />
      </>
    )}
  </body>
</html>

<style>
  .maintenance { min-height: 100vh; display: grid; place-items: center; padding: 2rem; }
  .maintenance h1 { font-size: clamp(3rem, 8vw, 6rem); margin-bottom: 1.5rem; }
</style>

---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";

import { client, urlFor } from "../lib/sanity";

const {
  title,
  description,
  image,
  url,
  type,
  publishedTime
} = Astro.props;

const siteSettings = await client.fetch(`
  *[_type == "siteSettings"][0]{
    organizationName,
    siteUrl,
    logo{ asset-> },
    linkedin,
    twitter,
    facebook,
    instagram
  }
`);

const baseUrl = siteSettings?.siteUrl || "https://nixwud.com";
const currentUrl = url || baseUrl;

// MAINTENANCE MODE SWITCH
const MAINTENANCE_MODE = true;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />

    <!-- TEMP: prevent indexing while under maintenance -->
    <meta name="robots" content="noindex, nofollow" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7RY15GCJ1Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7RY15GCJ1Z');
    </script>

    <SEO
      title={title}
      description={description}
      image={image}
      url={currentUrl}
      type={type}
      publishedTime={publishedTime}
    />

    {
      siteSettings && (
        <OrganizationSchema
          name={siteSettings.organizationName}
          url={baseUrl}
          logo={
            siteSettings.logo
              ? urlFor(siteSettings.logo).url()
              : undefined
          }
          sameAs={[
            siteSettings.linkedin,
            siteSettings.twitter,
            siteSettings.facebook,
            siteSettings.instagram
          ].filter(Boolean)}
        />
      )
    }
  </head>

  <body class="bg-black text-white">

    {
      MAINTENANCE_MODE ? (

        <div class="flex items-center justify-center min-h-screen text-center px-6">

          <div class="max-w-xl">

            <h1 class="text-5xl font-bold mb-6">
              Nixwud
            </h1>

            <p class="text-xl text-gray-400 mb-4">
              We're currently redesigning the experience.
            </p>


            <div class="text-sm text-gray-600">
              © {new Date().getFullYear()} Nixwud
            </div>

          </div>

        </div>

      ) : (

        <>
          <Navbar />
          <main>
            <slot />
          </main>
          <Footer />
        </>

      )
    }

  </body>
</html>
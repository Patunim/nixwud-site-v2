---
import "../styles/global.css";
import Navigation from "../components/layout/Navigation.astro";
import Footer from "../components/layout/Footer.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/siteConfig.js";
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
  getAbsoluteImageUrl,
  getCanonicalUrl,
  serializeJsonLd
} from "../lib/seo.js";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  authorName?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-default.png",
  canonical,
  type = "website",
  publishedTime,
  updatedTime,
  authorName,
  structuredData,
  noindex = false
} = Astro.props;

const siteName = SITE_NAME;
const pageTitle = title
  ? title.includes(siteName)
    ? title
    : `${title} | ${siteName}`
  : `${siteName} | Business & Technology Consultancy`;
const canonicalUrl = canonical || getCanonicalUrl(Astro.url.pathname);
const imageUrl = getAbsoluteImageUrl(image);
const maintenanceMode = import.meta.env.PUBLIC_MAINTENANCE_MODE === "true";
const configuredAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID || "G-7RY15GCJ1Z";
const analyticsId = /^G-[A-Z0-9]+$/i.test(configuredAnalyticsId) ? configuredAnalyticsId : undefined;
const searchConsoleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION?.trim();
const configuredClarityId = import.meta.env.PUBLIC_MICROSOFT_CLARITY_ID?.trim();
const clarityId = configuredClarityId && /^[a-z0-9]+$/i.test(configuredClarityId) ? configuredClarityId : undefined;

const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const baseSchemas = isHomepage
  ? [buildOrganizationSchema(), buildWebSiteSchema()]
  : [buildOrganizationSchema()];

const customSchemas = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const allSchemas = [...baseSchemas, ...customSchemas];
const serializedSchemas = allSchemas.map(serializeJsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(noindex || maintenanceMode) && <meta name="robots" content="noindex, nofollow" />}
    {searchConsoleVerification && <meta name="google-site-verification" content={searchConsoleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {authorName && <meta name="author" content={authorName} />}
    {serializedSchemas.map((schema) => <script is:inline type="application/ld+json" set:html={schema}></script>)}

  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {maintenanceMode ? (
      <main id="main-content" class="maintenance">
        <div class="container--narrow">
          <p class="eyebrow">Nixwud Consultancy</p>
          <h1>We are refining the experience.</h1>
          <p class="lede">The website will be available again shortly.</p>
        </div>
      </main>
    ) : (
      <>
        <Navigation />
        <main id="main-content"><slot /></main>
        <Footer />
      </>
    )}
    <AnalyticsConsent analyticsId={analyticsId} clarityId={clarityId} />
    <script>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: "0px 0px -20px 0px" }
        );

        document.querySelectorAll("section, .page-hero, .toolkit-feature, .toolkit-instrument, .featured-insight").forEach((el) => {
          el.classList.add("reveal-on-scroll");
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>

<style>
  .maintenance { min-height: 100vh; display: grid; place-items: center; padding: 2rem; }
  .maintenance h1 { font-size: clamp(3rem, 8vw, 6rem); margin-bottom: 1.5rem; }
</style>

---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { CONTACT_EMAIL } from "../lib/siteConfig.js";
---

<Layout title="Contact" description="Start a business and technology conversation with Nixwud Consultancy.">
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">Start a conversation</p>
      <h1>Tell us what your organization is trying to improve.</h1>
      <p class="lede">You do not need a finished brief or a predetermined solution. Begin with the business challenge, the decision or the opportunity.</p>
      <div class="button-row"><Button href={`mailto:${CONTACT_EMAIL}`} variant="primary">Email {CONTACT_EMAIL}</Button></div>
    </div>
  </header>

  <section class="section">
    <div class="container split">
      <div><p class="eyebrow">A useful first message</p><h2>Context helps us respond thoughtfully.</h2></div>
      <ul class="list-clean list-lines">
        <li>What is changing or not working as expected?</li>
        <li>Who is affected by the decision?</li>
        <li>What outcome would make the work valuable?</li>
        <li>Is there a deadline, constraint or existing system we should understand?</li>
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container--wide">
      <p class="eyebrow paper-eyebrow">What happens next</p>
      <ol class="next grid grid--3">
        <li><span>01</span><h3>We read the context</h3><p>We review your note and identify the most useful questions.</p></li>
        <li><span>02</span><h3>We clarify the need</h3><p>If there is a fit, we arrange a focused conversation.</p></li>
        <li><span>03</span><h3>We recommend a next step</h3><p>That may be a diagnostic, a defined engagement or honest guidance elsewhere.</p></li>
      </ol>
    </div>
  </section>
</Layout>

<style>
  .paper-eyebrow { color: #3554d8; }
  .next { list-style: none; padding: 0; margin: 0; }
  .next li { padding-top: 1.2rem; border-top: 1px solid var(--line-dark); }
  .next span { color: #3554d8; font-size: .78rem; font-weight: 800; }
  .next h3 { margin: 2.5rem 0 .8rem; }
</style>

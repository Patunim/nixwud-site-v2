---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import { CONTACT_EMAIL } from "../lib/siteConfig.js";
import { buildBreadcrumbSchema, getCanonicalUrl } from "../lib/seo.js";

const canonicalUrl = getCanonicalUrl("/contact");
const breadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Contact", url: "/contact" }
]);

const projectStages = [
  { step: "01", label: "Share the Problem", desc: "Tell us about your website, custom tool, CRM workflow or search goals." },
  { step: "02", label: "Technical Review", desc: "We review your requirements and identify the key architectural questions." },
  { step: "03", label: "Direct Discussion", desc: "A practical 30-minute introductory conversation directly with a builder." },
  { step: "04", label: "Project Plan", desc: "A clear proposal with defined scope, milestones, architecture and timeline." }
];
---

<Layout
  title="Start a Project"
  description="Contact Nixwud to discuss your website redesign, custom web application, CRM workflow automation or technical SEO project."
  canonical={canonicalUrl}
  structuredData={breadcrumbs}
>
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">Start a Project</p>
      <h1>Have something that needs building?</h1>
      <p class="lede">
        Tell us what your organisation is trying to achieve. You do not need a finished technical brief. Start with the problem, your goals or what is currently not working.
      </p>
      <div class="button-row">
        <Button href={`mailto:${CONTACT_EMAIL}`} variant="primary">Email {CONTACT_EMAIL}</Button>
      </div>
    </div>
  </header>

  <!-- Project Progression -->
  <section class="section border-bottom contact-track-section">
    <div class="container--wide">
      <div class="contact-track-box">
        <span class="track-kicker">Project Progression</span>
        <h2>From initial note to a working digital system.</h2>
        <div class="contact-track">
          {projectStages.map((stage, idx) => (
            <div class="track-step">
              <div class="track-step__marker">
                <span class="track-step__num">{stage.step}</span>
                {idx < projectStages.length - 1 && <span class="track-step__line" aria-hidden="true"></span>}
              </div>
              <h3>{stage.label}</h3>
              <p>{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Helpful First Note Guidance -->
  <section class="section section--paper">
    <div class="container split">
      <div>
        <p class="eyebrow paper-eyebrow">A Useful First Note</p>
        <h2>Helpful context for our initial response.</h2>
        <p class="lede">A few bullet points on these topics help us provide a thoughtful, concrete response.</p>
      </div>
      <ul class="list-clean context-questions">
        <li><span>01</span> What needs building or improving? (Website, custom web app, CRM automation or search discoverability)</li>
        <li><span>02</span> What is the main problem or friction your team or users are experiencing?</li>
        <li><span>03</span> What specific business outcome or metric would make this project a success?</li>
        <li><span>04</span> Are there target timelines, existing tools or budget parameters we should know about?</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .contact-track-section {
    padding-block: clamp(3rem, 5vw, 5rem);
    background-image: radial-gradient(circle at 85% 50%, rgba(83, 109, 206, 0.04) 0%, transparent 60%);
  }

  .contact-track-box {
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
  }

  .track-kicker {
    display: block;
    color: var(--accent-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .contact-track-box h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    margin: 0 0 3rem;
  }

  .contact-track {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .track-step {
    display: flex;
    flex-direction: column;
  }

  .track-step__marker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    position: relative;
  }

  .track-step__num {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.3);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-soft);
  }

  .track-step__line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .track-step h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text);
  }

  .track-step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .paper-eyebrow {
    color: var(--accent);
  }

  .context-questions li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line-dark);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .context-questions li:last-child {
    border-bottom: 1px solid var(--line-dark);
  }

  .context-questions span {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .contact-track {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .track-step__line {
      display: none;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import CTA from "../components/sections/CTA.astro";
import { services } from "../lib/siteConfig.js";
---

<Layout title="Consulting Services" description="Strategy, digital platforms, AI and automation, and discoverability services from Nixwud Consultancy.">
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">Consulting services</p>
      <h1>Capabilities connected by one principle: business value first.</h1>
      <p class="lede">We combine strategy, analysis and modern technology to help organizations understand the problem, choose an appropriate response and deliver lasting value.</p>
    </div>
  </header>

  <section class="section">
    <div class="container--wide grid grid--2">{services.map((service) => <ServiceCard service={service} />)}</div>
  </section>

  <section class="section section--paper">
    <div class="container split">
      <div><p class="eyebrow paper-eyebrow">Engagement model</p><h2>Start with the decision, then shape the work.</h2></div>
      <ol class="engagement list-clean">
        <li><span>01</span><div><strong>Focused discovery</strong><p>Understand context, evidence, stakeholders and constraints.</p></div></li>
        <li><span>02</span><div><strong>Decision framing</strong><p>Clarify options, trade-offs, priorities and measures of success.</p></div></li>
        <li><span>03</span><div><strong>Measured delivery</strong><p>Implement in useful stages and learn from real outcomes.</p></div></li>
      </ol>
    </div>
  </section>
  <CTA title="Not sure which service fits? Start with the business problem." />
</Layout>

<style>
  .paper-eyebrow { color: #3554d8; }
  .engagement li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--line-dark); }
  .engagement li:last-child { border-bottom: 1px solid var(--line-dark); }
  .engagement span { color: #3554d8; font-size: .8rem; font-weight: 800; }
  .engagement strong { color: var(--ink); font-size: 1.1rem; }
  .engagement p { margin: .35rem 0 0; }
</style>

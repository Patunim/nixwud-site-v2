---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/sections/CTA.astro";
import { buildBreadcrumbSchema, getCanonicalUrl } from "../lib/seo.js";

const canonicalUrl = getCanonicalUrl("/industries");
const breadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Industries", url: "/industries" }
]);

const smeProgression = [
  { step: "01", label: "Growth", desc: "Commercial demand increases" },
  { step: "02", label: "More Customers", desc: "Volume expands across channels" },
  { step: "03", label: "More Information", desc: "Records fragment across tools" },
  { step: "04", label: "More Processes", desc: "Workflows multiply informally" },
  { step: "05", label: "More Tools", desc: "Software adopted ad-hoc" },
  { step: "06", label: "Compounded Complexity", desc: "Systems slow execution down" }
];

const smeLenses = [
  {
    num: "01",
    title: "Operational Complexity",
    summary: "Processes that once worked informally around a small table become difficult to manage consistently as team size and customer volume expand."
  },
  {
    num: "02",
    title: "Information Fragmentation",
    summary: "Important customer, operational and financial information becomes scattered across separate spreadsheets, inboxes and disconnected SaaS tools."
  },
  {
    num: "03",
    title: "Customer Management",
    summary: "New enquiries, active prospects and existing clients require structured pipelines and predictable follow-up rather than ad-hoc email threads."
  },
  {
    num: "04",
    title: "Automation Opportunities",
    summary: "Manual data entry, status chasing and repetitive handoffs begin consuming hours that should be invested in high-value client advisory work."
  },
  {
    num: "05",
    title: "Technology Decisions",
    summary: "The financial and operational cost of choosing the wrong system increases rapidly as organizational interdependencies multiply."
  }
];

const smeCapabilities = [
  {
    title: "Business & Strategy",
    slug: "strategy-business-analysis",
    focus: "Process understanding, requirements definition, decision support and operating model design."
  },
  {
    title: "Digital Platforms",
    slug: "digital-platforms",
    focus: "Websites, customer portals and digital foundations built around clarity, speed and conversion."
  },
  {
    title: "CRM & Business Systems",
    slug: "ai-crm-business-automation",
    focus: "Customer records, structured pipeline tracking, handoffs and cross-team operational visibility."
  },
  {
    title: "AI & Automation",
    slug: "ai-automation",
    focus: "Workflow automation, document triage and AI-assisted tasks to eliminate operational bottlenecks."
  },
  {
    title: "Growth & Discoverability",
    slug: "growth-discoverability",
    focus: "Search discoverability, clear positioning and structured pathways from first visit to enquiry."
  }
];

const eduJourney = [
  { stage: "Discover", role: "Search, reputation, course directories", friction: "Unclear programme options and scattered requirement details" },
  { stage: "Enquire", role: "High-volume inbound questions and forms", friction: "Delayed responses, lost leads and manual inbox triage" },
  { stage: "Qualify", role: "Eligibility checks and goal alignment", friction: "Repetitive document chasing and disconnected advisor notes" },
  { stage: "Engage", role: "Admissions, onboarding and scheduling", friction: "Friction-heavy onboarding and missed administrative handoffs" },
  { stage: "Deliver", role: "Coaching, teaching, training and mentoring", friction: "Advisors buried in paperwork rather than human delivery" },
  { stage: "Follow Up", role: "Retention, outcomes, progression and alumni", friction: "Incomplete outcome tracking and lack of longitudinal data" }
];

const eduEcosystem = [
  { label: "People", role: "Students, candidates, advisors, coaches, administrators" },
  { label: "Information", role: "Enquiries, assessments, academic progress, placement records" },
  { label: "Processes", role: "Onboarding, qualification, scheduling, feedback, verification" },
  { label: "Communication", role: "Multichannel outreach, advisory sessions, automated alerts" },
  { label: "Technology", role: "CRMs, portals, forms, knowledge bases, analytics" },
  { label: "Outcomes", role: "Successful completions, career placements, operational leverage" }
];

const eduCapabilities = [
  {
    title: "Operations & Business Analysis",
    slug: "strategy-business-analysis",
    focus: "Map candidate and advisor workflows, uncover bottlenecks, and design clean operational handoffs."
  },
  {
    title: "CRM & Relationship Management",
    slug: "ai-crm-business-automation",
    focus: "Organize enquiries, applicants, cohorts and alumni into unified, structured relationship records."
  },
  {
    title: "Workflow Automation",
    slug: "ai-automation",
    focus: "Automate appointment reminders, status updates, document intake and recurring administration."
  },
  {
    title: "Digital Platforms",
    slug: "digital-platforms",
    focus: "Build intuitive course directories, self-service portals and accessible registration journeys."
  },
  {
    title: "AI & Knowledge Systems",
    slug: "ai-automation",
    focus: "Equip advisors and candidates with instant, verified access to programme curricula and policies."
  },
  {
    title: "Growth & Discoverability",
    slug: "growth-discoverability",
    focus: "Position specialized educational and career programmes in front of high-intent learners."
  }
];

const decisionLensSteps = [
  { num: "01", question: "What is actually happening?", detail: "Separate observed operational behavior from stated management assumptions." },
  { num: "02", question: "Where is the friction?", detail: "Pinpoint where handoffs, delays, rework and data loss occur across the workflow." },
  { num: "03", question: "What constraint matters most?", detail: "Determine which regulatory, legacy or human capacity boundaries cannot be moved." },
  { num: "04", question: "What needs to change?", detail: "Define the operating process and governance requirements before evaluating tools." },
  { num: "05", question: "What technology actually helps?", detail: "Select the most maintainable, cost-effective system that solves the core problem." }
];
---

<Layout
  title="Industry Context & Sector Analysis | Nixwud Consultancy"
  description="How industry context shapes business, technology and operational decisions across sectors, featuring in-depth perspectives on growing businesses and educational services."
  canonical={canonicalUrl}
  structuredData={breadcrumbs}
>
  <!-- Hero Section -->
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">Industry Context</p>
      <h1>Industry context changes the decision.</h1>
      <p class="lede">
        We work across sectors, adapting our approach to the operational and commercial realities of each organization. We are currently developing deeper published perspectives around SMEs, growing businesses, and educational and career services.
      </p>

      <div class="hero-context-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>Featured Perspectives: 01 SMEs & Growing Businesses | 02 Educational & Career Services</span>
      </div>
    </div>
  </header>

  <!-- Interactive Context Selector Rail -->
  <section class="section border-bottom context-selector-section">
    <div class="container--wide">
      <div class="context-selector-header">
        <span class="diagram-kicker">Sector Focus</span>
        <h2 class="context-selector-title">Featured industry perspectives</h2>
        <p class="context-selector-sub">
          Explore how our consulting approach adapts across different operating environments. More industry perspectives will be developed as Nixwud's published body of work grows.
        </p>
      </div>

      <div class="context-selector-rail" role="region" aria-label="Featured sector perspectives">
        <a href="#sme-context" class="context-select-card" data-target="sme-context">
          <div class="context-select-card__header">
            <span class="context-select-card__num">01</span>
            <span class="context-select-card__tag">Featured Perspective</span>
          </div>
          <h3>SMEs & Growing Businesses</h3>
          <p class="context-select-card__quote">"Growth creates pressure. Better systems create leverage."</p>
          <div class="context-select-card__action">
            <span>Explore SME Perspective</span>
            <span class="arrow" aria-hidden="true">↓</span>
          </div>
        </a>

        <a href="#education-context" class="context-select-card" data-target="education-context">
          <div class="context-select-card__header">
            <span class="context-select-card__num">02</span>
            <span class="context-select-card__tag">Featured Perspective</span>
          </div>
          <h3>Educational & Career Services</h3>
          <p class="context-select-card__quote">"When the service depends on people, the systems behind it matter."</p>
          <div class="context-select-card__action">
            <span>Explore Education Perspective</span>
            <span class="arrow" aria-hidden="true">↓</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 01: SME Context Experience -->
  <section id="sme-context" class="section border-bottom sector-deep-dive">
    <div class="container--wide">
      <div class="sector-header">
        <span class="sector-kicker">Context 01</span>
        <h2 class="sector-title">SMEs & Growing Businesses</h2>
        <p class="sector-tagline">Growth is useful. Complexity isn't.</p>
      </div>

      <!-- The Growth Complexity Cycle Diagram -->
      <div class="complexity-cycle-box">
        <div class="complexity-cycle-box__intro">
          <span class="diagram-kicker">Diagnostic Progression</span>
          <h3>How operational friction compounds with scale</h3>
          <p>
            When a business expands, processes that functioned informally begin to fray. Adding tools without an underlying operating architecture creates disconnected data silos and administrative drag.
          </p>
        </div>

        <div class="progression-track" role="list" aria-label="Growth to complexity progression">
          {smeProgression.map((item, idx) => (
            <div class="progression-node" role="listitem">
              <span class="progression-node__step">{item.step}</span>
              <h4 class="progression-node__label">{item.label}</h4>
              <p class="progression-node__desc">{item.desc}</p>
              {idx < smeProgression.length - 1 && <span class="progression-node__arrow" aria-hidden="true">→</span>}
            </div>
          ))}
        </div>

        <div class="strategic-pivot-banner">
          <div class="strategic-pivot-banner__inner">
            <span class="pivot-label">The Core Consulting Question</span>
            <p class="pivot-from">The question is not: <em>"What software do we need?"</em></p>
            <p class="pivot-to">The question is: <strong>"What needs to work better?"</strong></p>
          </div>
        </div>
      </div>

      <!-- SME Decision Lens: What Changes as a Business Grows -->
      <div class="sector-lens-block">
        <div class="sector-lens-header">
          <span class="diagram-kicker">Operating Dimensions</span>
          <h3>What changes as a business grows?</h3>
          <p>Five structural shifts that dictate whether technology creates leverage or unnecessary overhead.</p>
        </div>

        <div class="lens-grid">
          {smeLenses.map((lens) => (
            <div class="lens-card">
              <span class="lens-card__num">{lens.num}</span>
              <h4>{lens.title}</h4>
              <p>{lens.summary}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Where Nixwud Helps SMEs -->
      <div class="sector-capabilities-block">
        <div class="sector-capabilities-header">
          <span class="diagram-kicker">Capability Alignment</span>
          <h3>Where Nixwud helps growing businesses</h3>
          <p>We connect industry context directly to practical, measurable consulting capabilities.</p>
        </div>

        <div class="capabilities-matrix">
          {smeCapabilities.map((cap) => (
            <a href={`/services/${cap.slug}`} class="capability-item">
              <div class="capability-item__top">
                <h4>{cap.title}</h4>
                <span class="capability-item__link-icon" aria-hidden="true">↗</span>
              </div>
              <p>{cap.focus}</p>
              <span class="capability-item__cta">View {cap.title} service</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 02: Educational & Career Services Context Experience -->
  <section id="education-context" class="section border-bottom sector-deep-dive sector-deep-dive--alt">
    <div class="container--wide">
      <div class="sector-header">
        <span class="sector-kicker">Context 02</span>
        <h2 class="sector-title">Educational & Career Services</h2>
        <p class="sector-tagline">
          Education and career services are people businesses. The systems behind them should make the experience easier, not harder.
        </p>
      </div>

      <!-- Context Scope Badges -->
      <div class="sector-scope-bar">
        <span class="scope-label">Operating Environments:</span>
        <ul class="list-clean scope-tag-list">
          <li class="scope-tag">Educational Service Providers</li>
          <li class="scope-tag">Career Development Firms</li>
          <li class="scope-tag">Employability Organizations</li>
          <li class="scope-tag">Student Support Services</li>
          <li class="scope-tag">Professional Training Businesses</li>
        </ul>
      </div>

      <!-- Candidate & Student Journey Friction Map -->
      <div class="journey-friction-box">
        <div class="journey-friction-box__intro">
          <span class="diagram-kicker">Journey Architecture</span>
          <h3>The Candidate & Student Journey</h3>
          <p>
            In people-driven services, a single learner or candidate passes through distinct operational phases. Friction occurs when data and communication break down between stages.
          </p>
        </div>

        <div class="journey-track" role="list" aria-label="Educational candidate journey stages">
          {eduJourney.map((item, idx) => (
            <div class="journey-card" role="listitem">
              <div class="journey-card__header">
                <span class="journey-card__step">0{idx + 1}</span>
                <h4 class="journey-card__stage">{item.stage}</h4>
              </div>
              <div class="journey-card__body">
                <span class="journey-card__sublabel">Operational Role</span>
                <p class="journey-card__role">{item.role}</p>
                <span class="journey-card__sublabel journey-card__sublabel--friction">Friction Point</span>
                <p class="journey-card__friction">{item.friction}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- The System Behind the Service Lens -->
      <div class="system-ecosystem-box">
        <div class="system-ecosystem-header">
          <span class="diagram-kicker">Human-Centered Systems</span>
          <h3>The system behind the service</h3>
          <p class="lede-compact">
            Better systems should reduce friction for the people delivering the service and the people receiving it.
          </p>
        </div>

        <div class="ecosystem-flow" role="list" aria-label="Ecosystem flow">
          {eduEcosystem.map((eco, idx) => (
            <div class="ecosystem-node" role="listitem">
              <span class="ecosystem-node__idx">0{idx + 1}</span>
              <h4>{eco.label}</h4>
              <p>{eco.role}</p>
              {idx < eduEcosystem.length - 1 && <span class="ecosystem-node__connector" aria-hidden="true">↔</span>}
            </div>
          ))}
        </div>
      </div>

      <!-- Where Nixwud Helps Educational & Career Services -->
      <div class="sector-capabilities-block">
        <div class="sector-capabilities-header">
          <span class="diagram-kicker">Capability Alignment</span>
          <h3>Where Nixwud helps education and career organizations</h3>
          <p>Targeted consulting to streamline advisor workflows, candidate data and institutional delivery.</p>
        </div>

        <div class="capabilities-matrix">
          {eduCapabilities.map((cap) => (
            <a href={`/services/${cap.slug}`} class="capability-item">
              <div class="capability-item__top">
                <h4>{cap.title}</h4>
                <span class="capability-item__link-icon" aria-hidden="true">↗</span>
              </div>
              <p>{cap.focus}</p>
              <span class="capability-item__cta">View {cap.title} service</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Signature Nixwud Section: The Decision Lens -->
  <section class="section border-bottom section--paper decision-lens-section">
    <div class="container--wide">
      <div class="decision-lens-intro">
        <p class="eyebrow paper-eyebrow">Signature Methodology</p>
        <h2>The Decision Lens</h2>
        <p class="lede paper-lede">
          Across every industry context, Nixwud follows a rigorous sequence. We never start with software recommendations; we start with the operational reality.
        </p>
      </div>

      <div class="decision-lens-timeline" role="list" aria-label="The Decision Lens 5-step sequence">
        {decisionLensSteps.map((step) => (
          <div class="timeline-step" role="listitem">
            <span class="timeline-step__num">{step.num}</span>
            <div class="timeline-step__content">
              <h3>{step.question}</h3>
              <p>{step.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Context to Resources Toolkit Bridge -->
  <section class="section border-bottom toolkit-bridge-section">
    <div class="container--wide">
      <div class="toolkit-bridge-grid">
        <div class="toolkit-bridge-card">
          <span class="toolkit-tag">Diagnostic Tool</span>
          <h3>Decision Readiness Scorecard</h3>
          <p>
            Evaluate your organization's clarity across business alignment, requirements, technical feasibility and operational readiness before committing budget.
          </p>
          <a href="/resources/decision-readiness-scorecard/" class="button button--secondary">
            Launch Scorecard
          </a>
        </div>

        <div class="toolkit-bridge-card">
          <span class="toolkit-tag">Core Practices</span>
          <h3>Consulting Capabilities</h3>
          <p>
            Explore how our Strategy, Digital Platforms, AI Automation, CRM and Discoverability practices connect to address complex operational challenges.
          </p>
          <a href="/services/" class="button button--secondary">
            Explore All Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CTA
    title="Have a decision you need to make?"
    description="Tell us what you're trying to improve, where the uncertainty sits, and what you've already considered."
  />
</Layout>

<style>
  /* Hero contextual badge */
  .hero-context-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--ink-soft);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* Context Selector Rail */
  .context-selector-section {
    padding: 3rem 0;
    background: var(--bg-alt, rgba(14, 17, 24, 0.6));
  }

  .context-selector-header {
    max-width: 46rem;
    margin-bottom: 2rem;
  }

  .context-selector-title {
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    color: var(--text);
    margin: 0 0 0.5rem;
  }

  .context-selector-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: var(--leading-body);
    margin: 0;
  }

  .context-selector-rail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .context-select-card {
    display: flex;
    flex-direction: column;
    padding: 2rem 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .context-select-card:hover {
    transform: translateY(-2px);
    border-color: rgba(97, 125, 255, 0.45);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .context-select-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .context-select-card__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-soft);
  }

  .context-select-card__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .context-select-card h3 {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    color: var(--text);
    margin: 0 0 0.75rem;
  }

  .context-select-card__quote {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.5;
    margin: 0 0 1.5rem;
    flex-grow: 1;
  }

  .context-select-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-soft);
  }

  .context-select-card__action .arrow {
    transition: transform 200ms ease;
  }

  .context-select-card:hover .arrow {
    transform: translateY(3px);
  }

  /* Sector Deep Dive Sections */
  .sector-deep-dive {
    padding: clamp(3rem, 6vw, 5.5rem) 0;
  }

  .sector-deep-dive--alt {
    background: rgba(14, 17, 26, 0.4);
  }

  .sector-header {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .sector-kicker {
    display: inline-block;
    color: var(--accent-soft);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .sector-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin: 0 0 0.75rem;
    color: var(--text);
  }

  .sector-tagline {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: var(--text-muted);
    line-height: 1.45;
    margin: 0;
  }

  /* Complexity Cycle Progression */
  .complexity-cycle-box {
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
    margin-bottom: 3.5rem;
  }

  .diagram-kicker {
    display: block;
    color: var(--accent-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .complexity-cycle-box__intro h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    margin: 0 0 0.75rem;
  }

  .complexity-cycle-box__intro p {
    color: var(--text-muted);
    max-width: 42rem;
    line-height: var(--leading-body);
    margin: 0 0 2rem;
  }

  .progression-track {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .progression-node {
    position: relative;
    padding: 1.25rem 1rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .progression-node__step {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }

  .progression-node__label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }

  .progression-node__desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .progression-node__arrow {
    position: absolute;
    right: -0.65rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-weight: 700;
    font-size: 1rem;
    z-index: 2;
  }

  .strategic-pivot-banner {
    padding: 1.5rem 1.75rem;
    border-left: 3px solid var(--accent);
    background: rgba(97, 125, 255, 0.08);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .pivot-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }

  .pivot-from {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }

  .pivot-to {
    color: var(--text);
    font-size: 1.15rem;
    margin: 0;

---
import Layout from "../../layouts/Layout.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import CTA from "../../components/sections/CTA.astro";
import { safeFetch, safeImageUrl, toValidDate } from "../../lib/sanity.js";
import { SITE_NAME, SITE_URL } from "../../lib/siteConfig.js";

export async function getStaticPaths() {
  const posts = await safeFetch(`*[_type == "post" && !(_id in path("drafts.**")) && defined(title) && defined(slug.current)]{
    "slug": slug.current
  }`, {}, []) as Array<{ slug: string }>;
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const post = await safeFetch(`*[_type == "post" && !(_id in path("drafts.**")) && slug.current == $slug][0]{
    title, keyInsight, excerpt, summary, body, publishedAt, updatedAt, mainImage,
    seoTitle, seoDescription, reviewedAt, factCheckedAt, faqs,
    "slug": slug.current,
    "categories": categories[]->title,
    author->{name, "slug": slug.current, bio, image},
    reviewedBy->{name, "slug": slug.current},
    sources[]{title, url, publisher, publishedAt}
  }`, { slug: Astro.params.slug }, null) as Record<string, any> | null;

if (!post) {
  return Astro.redirect("/insights", 302);
}

const heroWidths = { small: 720, medium: 960, large: 1200, full: 1600 } as const;
const heroSize = Object.hasOwn(heroWidths, post.mainImage?.displaySize)
  ? post.mainImage.displaySize as keyof typeof heroWidths
  : "medium";
const heroAlignment = ["left", "center", "right"].includes(post.mainImage?.alignment)
  ? post.mainImage.alignment
  : "center";
const heroWidth = heroWidths[heroSize];
const heroHeight = Math.round(heroWidth * 9 / 16);
const heroImage = safeImageUrl(post.mainImage, (image) => image.width(heroWidth).height(heroHeight).fit("crop").auto("format").quality(88));
const heroSrcset = [480, 720, 960, 1200, 1600]
  .filter((width) => width <= heroWidth)
  .map((width) => {
    const url = safeImageUrl(post.mainImage, (image) => image.width(width).height(Math.round(width * 9 / 16)).fit("crop").auto("format").quality(88));
    return url ? `${url} ${width}w` : "";
  })
  .filter(Boolean)
  .join(", ");
const heroSizes = heroSize === "small"
  ? "(max-width: 760px) calc(100vw - 2rem), 720px"
  : heroSize === "medium"
    ? "(max-width: 1000px) calc(100vw - 2rem), 960px"
    : heroSize === "large"
      ? "(max-width: 1240px) calc(100vw - 2rem), 1200px"
      : "(max-width: 1400px) calc(100vw - 2rem), 1376px";
const publishedDate = toValidDate(post.publishedAt);
const published = publishedDate
  ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(publishedDate)
  : null;
const modifiedDate = toValidDate(post.updatedAt);
const modified = modifiedDate
  ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(modifiedDate)
  : null;
const reviewedDate = toValidDate(post.reviewedAt || post.factCheckedAt);
const reviewed = reviewedDate
  ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(reviewedDate)
  : null;
const sources = (Array.isArray(post.sources) ? post.sources : []).filter(
  (source): source is { title: string; url: string; publisher?: string; publishedAt?: string } =>
    typeof source?.title === "string" && typeof source?.url === "string" && /^https?:\/\//i.test(source.url)
);
const faqs = (Array.isArray(post.faqs) ? post.faqs : []).filter(
  (faq): faq is { question: string; answer: string } =>
    typeof faq?.question === "string" && Boolean(faq.question.trim()) && typeof faq?.answer === "string" && Boolean(faq.answer.trim())
);
const bodyText = Array.isArray(post.body)
  ? post.body.flatMap((block: Record<string, any>) =>
      Array.isArray(block?.children) ? block.children.map((child: Record<string, any>) => child?.text || "") : []
    ).join(" ")
  : "";
const wordCount = bodyText.trim() ? bodyText.trim().split(/\s+/).length : 0;
const readingMinutes = wordCount ? Math.max(1, Math.ceil(wordCount / 225)) : null;
const metaTitle = post.seoTitle || post.title;
const metaDescription = post.seoDescription || post.excerpt || post.summary || post.keyInsight;
const canonicalUrl = new URL(`/insights/${post.slug}`, SITE_URL).toString();
const authorUrl = post.author?.slug ? new URL(`/authors/${post.author.slug}`, SITE_URL).toString() : undefined;
const reviewerUrl = post.reviewedBy?.slug ? new URL(`/authors/${post.reviewedBy.slug}`, SITE_URL).toString() : undefined;
const logoUrl = new URL("/favicon.svg", SITE_URL).toString();
const socialImage = safeImageUrl(post.mainImage, (image) => image.width(1200).height(630).fit("crop").auto("format").quality(88));
const schemaImages = [
  safeImageUrl(post.mainImage, (image) => image.width(1200).height(1200).fit("crop").auto("format").quality(88)),
  safeImageUrl(post.mainImage, (image) => image.width(1200).height(900).fit("crop").auto("format").quality(88)),
  safeImageUrl(post.mainImage, (image) => image.width(1200).height(675).fit("crop").auto("format").quality(88))
].filter((image): image is string => Boolean(image));
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonicalUrl}#article`,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
    reviewedBy: post.reviewedBy?.name
      ? { "@type": "Person", "@id": reviewerUrl ? `${reviewerUrl}#person` : undefined, name: post.reviewedBy.name, url: reviewerUrl }
      : undefined,
    lastReviewed: post.reviewedAt || post.factCheckedAt || undefined
  },
  headline: post.title,
  description: metaDescription,
  image: schemaImages.length ? schemaImages : undefined,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt || undefined,
  inLanguage: "en",
  isAccessibleForFree: true,
  author: post.author?.name
    ? { "@type": "Person", "@id": authorUrl ? `${authorUrl}#person` : undefined, name: post.author.name, url: authorUrl }
    : { "@type": "Organization", "@id": `${SITE_URL}#organization`, name: SITE_NAME, url: SITE_URL },
  publisher: {
    "@type": "Organization",
    "@id": `${SITE_URL}#organization`,
    name: SITE_NAME,
    url: SITE_URL,
    logo: { "@type": "ImageObject", url: logoUrl }
  },
  articleSection: Array.isArray(post.categories) ? post.categories : undefined,
  wordCount: wordCount || undefined,
  citation: sources.length
    ? sources.map((source) => ({
        "@type": "CreativeWork",
        name: source.title,
        url: source.url,
        publisher: source.publisher ? { "@type": "Organization", name: source.publisher } : undefined,
        datePublished: source.publishedAt
      }))
    : undefined
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    { "@type": "ListItem", position: 2, name: "Insights", item: new URL("/insights", SITE_URL).toString() },
    { "@type": "ListItem", position: 3, name: post.title, item: canonicalUrl }
  ]
};
const faqSchema = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    }
  : null;
const structuredData = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
const heroCaption = typeof post.mainImage?.caption === "string" ? post.mainImage.caption.trim() : "";
const heroCredit = typeof post.mainImage?.credit === "string" ? post.mainImage.credit.trim() : "";
const heroCreditUrl = typeof post.mainImage?.creditUrl === "string" && /^https?:\/\//i.test(post.mainImage.creditUrl)
  ? post.mainImage.creditUrl
  : "";
---

<Layout
  title={metaTitle}
  description={metaDescription}
  image={socialImage || heroImage}
  canonical={canonicalUrl}
  type="article"
  publishedTime={post.publishedAt}
  updatedTime={post.updatedAt}
  authorName={post.author?.name}
  structuredData={structuredData}
>
  <div class="reading-progress-bar" id="reading-progress" aria-hidden="true"></div>
  <header class="article-hero">
    <div class="container--narrow">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/insights">Insights</a></nav>
      <p class="eyebrow">{post.categories?.[0] || "Insight"}</p>
      <h1>{post.title}</h1>
      {post.excerpt && <p class="lede">{post.excerpt}</p>}
      <div class="article-meta">
        {post.author?.name && post.author?.slug
          ? <a href={`/authors/${post.author.slug}`}>{post.author.name}</a>
          : post.author?.name && <span>{post.author.name}</span>}
        {published && <span>Published <time datetime={post.publishedAt}>{published}</time></span>}
        {modified && <span>Updated <time datetime={post.updatedAt}>{modified}</time></span>}
        {readingMinutes && <span>{readingMinutes} min read</span>}
      </div>
      {(post.reviewedBy?.name || reviewed) && <p class="review-meta">Reviewed {post.reviewedBy?.name && <>by {post.reviewedBy.slug ? <a href={`/authors/${post.reviewedBy.slug}`}>{post.reviewedBy.name}</a> : post.reviewedBy.name}</>}{reviewed && <> on <time datetime={post.reviewedAt || post.factCheckedAt}>{reviewed}</time></>}</p>}
    </div>
  </header>

  {heroImage && <div class="container--wide hero-stage"><figure class={`hero-media hero-media--${heroSize} hero-media--${heroAlignment}`}><img class="hero-image" src={heroImage} srcset={heroSrcset || undefined} sizes={heroSizes} alt={post.mainImage?.alt || ""} width={heroWidth} height={heroHeight} loading="eager" fetchpriority="high" decoding="async" />{(heroCaption || heroCredit) && <figcaption>{heroCaption}{heroCaption && heroCredit && " · "}{heroCredit && <span class="hero-media__credit">Credit: {heroCreditUrl ? <a href={heroCreditUrl} target="_blank" rel="noopener noreferrer">{heroCredit}</a> : heroCredit}</span>}</figcaption>}</figure></div>}

  <section class="section--compact">
    {post.keyInsight && <aside class="article insight-box"><p class="kicker">Key insight</p><p>{post.keyInsight}</p></aside>}
    {post.summary && <aside class="article summary-box"><p class="kicker">In brief</p><p>{post.summary}</p></aside>}
    <ArticleBody value={post.body} />
  </section>

  {faqs.length > 0 && (
    <section class="section--compact border-top">
      <div class="article">
        <p class="eyebrow">Questions answered</p>
        <h2>Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <article class="faq-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {sources.length > 0 && (
    <section class="section--compact border-top"><div class="article"><h2>Sources</h2><ol class="sources">{sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>{source.publisher && <span>, {source.publisher}</span>}</li>)}</ol></div></section>
  )}
  <CTA title="Turn the insight into a clearer next step." />
</Layout>

<style>
  .article-hero { padding-block: clamp(4rem, 7vw, 6.5rem) clamp(2.5rem, 4vw, 4rem); }
  .article-hero h1 { font-size: var(--text-h1); font-weight: 600; line-height: var(--leading-display); letter-spacing: var(--tracking-display); max-width: 24ch; margin-bottom: 1.4rem; }
  .breadcrumbs { display: flex; gap: .6rem; margin-bottom: 2rem; color: var(--text-muted); font-size: .84rem; }
  .breadcrumbs a:hover { color: var(--text); }
  .article-meta { display: flex; flex-wrap: wrap; gap: 1rem 2rem; color: var(--text-muted); font-size: .875rem; }
  .article-meta a { color: var(--accent-soft); }
  .review-meta { margin: 1rem 0 0; color: var(--text-muted); font-size: .84rem; }
  .review-meta a { color: var(--accent-soft); }
  .hero-stage { display: flex; }
  .hero-media { margin-block: 0; }
  .hero-media--small { width: min(100%, 45rem); }
  .hero-media--medium { width: min(100%, 60rem); }
  .hero-media--large { width: min(100%, 75rem); }
  .hero-media--full { width: 100%; }
  .hero-media--left { margin-right: auto; }
  .hero-media--center { margin-inline: auto; }
  .hero-media--right { margin-left: auto; }
  .hero-image { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-lg); }
  .insight-box, .summary-box { margin-bottom: 2rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--ink-soft); }
  .insight-box { border-color: var(--accent); }
  .insight-box p:last-child, .summary-box p:last-child { margin: .6rem 0 0; color: var(--text); font-size: var(--text-body-lg); line-height: var(--leading-body-lg); }
  .faq-list { display: grid; margin-top: 1.5rem; }
  .faq-item { padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .faq-item:last-child { border-bottom: 1px solid var(--line); }
  .faq-item h3 { margin: 0 0 .65rem; color: var(--text); font-size: 1.15rem; font-weight: 600; line-height: 1.4; }
  .faq-item p { margin: 0; color: #d0cfca; font-size: 1.0625rem; line-height: 1.65; }
  .sources { padding-left: 1.3rem; }
  .sources li { margin-bottom: .8rem; color: var(--text-muted); }
  .sources a { color: var(--accent-soft); text-decoration: underline; }

  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--accent);
    z-index: 1000;
    pointer-events: none;
    transition: width 80ms linear;
  }
</style>

<script>
  function initReadingProgress() {
    const bar = document.getElementById("reading-progress");
    if (bar && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const updateProgress = () => {
        const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (totalScroll > 0) {
          const scrolled = (window.scrollY / totalScroll) * 100;
          bar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
        }
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    }
  }

  document.addEventListener("astro:page-load", initReadingProgress);
</script>

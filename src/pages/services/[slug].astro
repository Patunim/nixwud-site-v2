---
import Layout from "../../layouts/Layout.astro";
import CTA from "../../components/sections/CTA.astro";
import { serviceDetails, services } from "../../lib/siteConfig.js";
import { buildBreadcrumbSchema, buildServiceSchema, getCanonicalUrl } from "../../lib/seo.js";

export function getStaticPaths() {
  const details = serviceDetails as Record<string, Record<string, any>>;
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service, detail: details[service.slug] }
  }));
}

const { service, detail } = Astro.props as { service: Record<string, any>; detail: Record<string, any> };
const serviceUrl = getCanonicalUrl(`/services/${service.slug}`);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Services", url: "/services" },
  { name: service.title, url: `/services/${service.slug}` }
]);

const serviceSchema = buildServiceSchema({
  name: service.title,
  description: detail.description,
  url: serviceUrl
});
---

<Layout
  title={service.title}
  description={detail.description}
  canonical={serviceUrl}
  structuredData={[breadcrumbSchema, serviceSchema]}
>
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">{detail.eyebrow}</p>
      <h1>{detail.title}</h1>
      <p class="lede">{detail.description}</p>
    </div>
  </header>

  <!-- Distinct Practice Architectural System Diagram -->
  <section class="section border-bottom practice-system">
    <div class="container--wide">
      <div class="system-box">
        <div class="system-box__header">
          <span class="system-box__tag">Discipline Architecture</span>
          <h2>How we structure {service.title}</h2>
        </div>

        {/* 01. Web Design & Development Visual Blueprint */}
        {service.slug === "web-design-development" && (
          <div class="web-blueprint">
            <div class="blueprint-grid">
              <div class="blueprint-card">
                <span class="blueprint-num">01</span>
                <h3>Interface & Typography</h3>
                <p>Clean semantic HTML, responsive typography tokens and accessible UI components designed for clarity.</p>
                <div class="blueprint-tag-row">
                  <span class="b-tag">WCAG AA</span>
                  <span class="b-tag">Mobile First</span>
                  <span class="b-tag">Design Tokens</span>
                </div>
              </div>

              <div class="blueprint-card">
                <span class="blueprint-num">02</span>
                <h3>Content & CMS Schema</h3>
                <p>Structured content models allowing non-technical editors to update pages, navigation and resources easily.</p>
                <div class="blueprint-tag-row">
                  <span class="b-tag">Structured CMS</span>
                  <span class="b-tag">Modular Blocks</span>
                  <span class="b-tag">Zero Bloat</span>
                </div>
              </div>

              <div class="blueprint-card">
                <span class="blueprint-num">03</span>
                <h3>Speed & Engineering</h3>
                <p>Optimized asset delivery, minimal JavaScript bundles and fast static site generation on modern CDNs.</p>
                <div class="blueprint-tag-row">
                  <span class="b-tag">Core Web Vitals</span>
                  <span class="b-tag">LCP &lt; 1.0s</span>
                  <span class="b-tag">Edge Delivery</span>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* 02. Web & App Development Software Stack */}
        {service.slug === "web-app-development" && (
          <div class="app-arch-flow">
            <div class="arch-layer">
              <div class="arch-layer__head">
                <span class="layer-num">01</span>
                <h3>Workflow Interface Layer</h3>
              </div>
              <p>Custom dashboards, authenticated portals and operational forms tailored to specific team roles.</p>
            </div>
            <div class="arch-connector" aria-hidden="true">↓</div>
            <div class="arch-layer">
              <div class="arch-layer__head">
                <span class="layer-num">02</span>
                <h3>API & Business Logic Layer</h3>
              </div>
              <p>Secure authentication, role-based permissions, automated validation rules and webhook endpoints.</p>
            </div>
            <div class="arch-connector" aria-hidden="true">↓</div>
            <div class="arch-layer arch-layer--accent">
              <div class="arch-layer__head">
                <span class="layer-num">03</span>
                <h3>Database & System Integrations</h3>
              </div>
              <p>Reliable relational data storage, automated backups and bidirectional synchronization with third-party tools.</p>
            </div>
          </div>
        )}

        {/* 03. CRM & Automation Pipeline */}
        {service.slug === "crm-automation" && (
          <div class="crm-pipeline-flow">
            <div class="pipeline-step">
              <div class="pipeline-step__num">01</div>
              <h3>Data Capture</h3>
              <p>Inbound website leads, email inquiries, form submissions and appointment bookings.</p>
            </div>
            <span class="pipeline-arrow" aria-hidden="true">→</span>
            <div class="pipeline-step">
              <div class="pipeline-step__num">02</div>
              <h3>Smart Qualification</h3>
              <p>Automated validation, intent tagging and enrichment without manual human data entry.</p>
            </div>
            <span class="pipeline-arrow" aria-hidden="true">→</span>
            <div class="pipeline-step">
              <div class="pipeline-step__num">03</div>
              <h3>Instant Routing</h3>
              <p>Lead assignment to the right team member with full history and context attached.</p>
            </div>
            <span class="pipeline-arrow" aria-hidden="true">→</span>
            <div class="pipeline-step pipeline-step--accent">
              <div class="pipeline-step__num">04</div>
              <h3>Sync & Actions</h3>
              <p>Automated confirmation notifications, task reminders and CRM status synchronization.</p>
            </div>
          </div>
        )}

        {/* 04. SEO & Discoverability Matrix */}
        {service.slug === "seo-discoverability" && (
          <div class="seo-discoverability-grid">
            <div class="seo-pillar">
              <span class="pillar-num">01</span>
              <h3>Technical Foundations</h3>
              <p>Crawlability, clean canonical URLs, XML sitemaps, robots protocol and Core Web Vitals optimization.</p>
            </div>
            <div class="seo-pillar">
              <span class="pillar-num">02</span>
              <h3>Semantic Structure</h3>
              <p>Proper heading hierarchy, semantic HTML5 landmarks and structured JSON-LD schemas.</p>
            </div>
            <div class="seo-pillar">
              <span class="pillar-num">03</span>
              <h3>Content Architecture</h3>
              <p>Topic clustering, internal link graph design and high-intent informational page hierarchy.</p>
            </div>
            <div class="seo-pillar seo-pillar--accent">
              <span class="pillar-num">04</span>
              <h3>AI & Answer Engines</h3>
              <p>Entity modeling and structured data designed for direct citations across Google and AI search tools.</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Core Capabilities Breakdown -->
  <section class="section border-bottom">
    <div class="container split">
      <div>
        <p class="eyebrow">Scope & Capabilities</p>
        <h2>What we cover within this practice.</h2>
      </div>
      <ul class="list-clean list-lines">
        {((detail.capabilities as string[]) || []).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- When This Helps / Common Challenges -->
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">When this helps</p>
        <h2>Signs your current setup needs improvement.</h2>
      </div>
      <ul class="list-clean list-lines">
        {((detail.challenges as string[]) || []).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Typical Deliverables -->
  <section class="section section--paper">
    <div class="container--wide">
      <header class="deliverables-header">
        <p class="eyebrow paper-eyebrow">Concrete Deliverables</p>
        <h2>Practical deliverables your team can rely on.</h2>
        <p class="lede">Every engagement produces clean, documented deliverables that your organisation owns completely.</p>
      </header>
      <ul class="deliverables grid grid--2 list-clean">
        {((detail.deliverables as string[]) || []).map((item, index) => (
          <li class="deliverable-item">
            <span class="deliverable-num">0{index + 1}</span>
            <p class="deliverable-text">{item}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Philosophy Callout -->
  <section class="section border-bottom">
    <div class="container--narrow">
      <p class="eyebrow">Our Philosophy</p>
      <h2>Built around the problem, not predetermined templates.</h2>
      <p class="lede">
        {detail.philosophy || "We don't just build what you are asked for. We first work out what actually needs building to ensure every project creates lasting value."}
      </p>
    </div>
  </section>

  <CTA title={`Ready to build your ${service.shortTitle || service.title}?`} description="Tell us what you are trying to improve. We will review your requirements and outline a concrete path forward." />
</Layout>

<style>
  .practice-system {
    padding-block: clamp(3rem, 5vw, 5rem);
    background-image: radial-gradient(circle at 10% 50%, rgba(83, 109, 206, 0.04) 0%, transparent 60%);
  }

  .system-box {
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
  }

  .system-box__header {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .system-box__tag {
    display: block;
    color: var(--accent-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .system-box__header h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
  }

  /* 01. Web Blueprint */
  .blueprint-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .blueprint-card {
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
  }

  .blueprint-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-soft);
    margin-bottom: 0.75rem;
  }

  .blueprint-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: var(--text);
  }

  .blueprint-card p {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .blueprint-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .b-tag {
    padding: 0.2rem 0.5rem;
    background: rgba(83, 109, 206, 0.12);
    border: 1px solid rgba(83, 109, 206, 0.25);
    border-radius: var(--radius-xs);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent-soft);
  }

  /* 02. App Architecture */
  .app-arch-flow {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .arch-layer {
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.25);
  }

  .arch-layer--accent {
    border-color: rgba(83, 109, 206, 0.35);
    background: rgba(83, 109, 206, 0.06);
  }

  .arch-layer__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .layer-num {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent-soft);
  }

  .arch-layer h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--text);
  }

  .arch-layer p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .arch-connector {
    text-align: center;
    color: var(--accent-soft);
    font-size: 1.25rem;
    line-height: 1;
  }

  /* 03. CRM Pipeline */
  .crm-pipeline-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }

  .pipeline-step {
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.25);
    height: 100%;
  }

  .pipeline-step--accent {
    border-color: rgba(83, 109, 206, 0.4);
    background: rgba(83, 109, 206, 0.08);
  }

  .pipeline-step__num {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }

  .pipeline-step h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text);
  }

  .pipeline-step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .pipeline-arrow {
    color: var(--accent-soft);
    font-size: 1.25rem;
  }

  /* 04. SEO Grid */
  .seo-discoverability-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .seo-pillar {
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.25);
  }

  .seo-pillar--accent {
    border-color: rgba(83, 109, 206, 0.4);
    background: rgba(83, 109, 206, 0.08);
  }

  .pillar-num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }

  .seo-pillar h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text);
  }

  .seo-pillar p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  /* Deliverables */
  .deliverables-header {
    max-width: 48rem;
    margin-bottom: 3.5rem;
  }

  .paper-eyebrow {
    color: var(--accent);
  }

  .deliverables-header h2 {
    max-width: 22ch;
    margin-bottom: 1rem;
  }

  .deliverable-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line-dark);
  }

  .deliverable-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .deliverable-text {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.45;
  }

  @media (max-width: 960px) {
    .blueprint-grid,
    .seo-discoverability-grid {
      grid-template-columns: 1fr 1fr;
    }

    .crm-pipeline-flow {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pipeline-arrow {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .blueprint-grid,
    .seo-discoverability-grid {
      grid-template-columns: 1fr;
    }

    .deliverables {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/sections/CTA.astro";
import { caseStudies } from "../lib/siteConfig.js";
import { buildBreadcrumbSchema, getCanonicalUrl } from "../lib/seo.js";

const canonicalUrl = getCanonicalUrl("/case-studies");
const breadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Work", url: "/case-studies" }
]);

const deliveryStandards = [
  { step: "01", tag: "SPECIFICATION", label: "Clear Requirements", desc: "Define user workflows, data models and success criteria before building." },
  { step: "02", tag: "ENGINEERING", label: "Clean Codebase", desc: "Build lightweight, accessible, maintainable codebases with zero bloat." },
  { step: "03", tag: "INTEGRATION", label: "Reliable Systems", desc: "Connect forms, APIs and CRM pipelines with robust error handling." },
  { step: "04", tag: "DOCUMENTATION", label: "Complete Ownership", desc: "Provide full source code, CMS schemas and team operational guides." }
];
---

<Layout
  title="Selected Work & Systems Archive"
  description="Explore Nixwud's selected work across web design & development, custom web applications, CRM automation and technical search architecture."
  canonical={canonicalUrl}
  structuredData={breadcrumbs}
>
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">Work & Project Archive</p>
      <h1>Real systems engineered for operational results.</h1>
      <p class="lede">
        We design and build websites, web applications, CRM workflows and discoverability systems that solve concrete operational challenges.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container--wide">
      <div class="work-archive">
        {caseStudies.map((study, index) => (
          <article class="archive-item">
            <div class="archive-item__top">
              <span class="archive-item__num">0{index + 1}</span>
              <span class="archive-item__service">{study.service}</span>
            </div>
            <div class="archive-item__content">
              <p class="archive-item__client">{study.client || "Commercial Engagement"}</p>
              <h2>{study.title}</h2>
              <div class="archive-item__details">
                <div class="archive-block">
                  <span class="archive-block__label">The Operational Challenge</span>
                  <p>{study.challenge}</p>
                </div>
                <div class="archive-block archive-block--outcome">
                  <span class="archive-block__label">Delivered Solution & Outcome</span>
                  <p>{study.outcome}</p>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Delivery Standards Section -->
  <section class="section section--paper">
    <div class="container--wide">
      <header class="standards-header">
        <p class="eyebrow paper-eyebrow">Build Standards</p>
        <h2>What every Nixwud project delivers.</h2>
        <p class="lede">
          We hold every digital build, custom application and automation pipeline to strict technical and operational standards.
        </p>
      </header>

      <div class="standards-grid">
        {deliveryStandards.map((std) => (
          <div class="standard-card">
            <div class="standard-card__head">
              <span class="standard-num">{std.step}</span>
              <span class="standard-tag">{std.tag}</span>
            </div>
            <h3>{std.label}</h3>
            <p>{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA title="Have a project that needs building?" description="Share your requirements and we will help you map out a practical, high-performance solution." />
</Layout>

<style>
  .work-archive {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .archive-item {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 2.5rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
    transition: border-color var(--transition);
  }

  .archive-item:hover {
    border-color: rgba(83, 109, 206, 0.4);
  }

  .archive-item__top {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .archive-item__num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-soft);
    line-height: 1;
  }

  .archive-item__service {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .archive-item__client {
    margin: 0 0 0.5rem;
    color: var(--accent-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .archive-item__content h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1.25;
  }

  .archive-item__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .archive-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .archive-block__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .archive-block p {
    margin: 0;
    font-size: 0.95rem;
    line-height: var(--leading-body);
    color: var(--text-muted);
  }

  .archive-block--outcome p {
    color: var(--text);
  }

  /* Standards */
  .standards-header {
    max-width: 48rem;
    margin-bottom: 3.5rem;
  }

  .paper-eyebrow {
    color: var(--accent);
  }

  .standards-header h2 {
    max-width: 22ch;
    margin-bottom: 1rem;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .standard-card {
    padding: 1.75rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-sm);
    background: rgba(243, 241, 235, 0.7);
  }

  .standard-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .standard-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .standard-tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dark-muted);
  }

  .standard-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: var(--ink);
  }

  .standard-card p {
    margin: 0;
    color: var(--text-dark-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .archive-item {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .archive-item__details {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .standards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .standards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/sections/CTA.astro";
import { caseStudies } from "../lib/siteConfig.js";
import { buildBreadcrumbSchema, getCanonicalUrl } from "../lib/seo.js";

const canonicalUrl = getCanonicalUrl("/case-studies");
const breadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Work", url: "/case-studies" }
]);

const featuredStudy = caseStudies.find((s) => s.featured) || caseStudies[0];
const otherStudies = caseStudies.filter((s) => s.slug !== featuredStudy?.slug);

const buildStandards = [
  { step: "01", tag: "SPECIFICATION", label: "Clear Requirements", desc: "Work out what actually needs building and isolate the core operational requirements." },
  { step: "02", tag: "ENGINEERING", label: "Clean Codebase", desc: "Build lightweight, accessible, maintainable codebases with zero bloat." },
  { step: "03", tag: "INTEGRATION", label: "Reliable Systems", desc: "Connect forms, APIs and CRM pipelines with robust error handling." },
  { step: "04", tag: "DOCUMENTATION", label: "Complete Ownership", desc: "Provide full source code, CMS schemas and team operational guides." }
];
---

<Layout
  title="Selected Work & Case Studies"
  description="Explore selected examples of websites, custom web applications, CRM workflows and search systems designed and built by Nixwud."
  canonical={canonicalUrl}
  structuredData={breadcrumbs}
>
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">Selected Work</p>
      <h1>Websites, applications and digital systems we have built.</h1>
      <p class="lede">
        A selected archive of digital products, client portals, automated CRM workflows and discoverability systems engineered for real organisations.
      </p>
    </div>
  </header>

  <!-- Featured Project Showcase -->
  {featuredStudy && (
    <section class="section border-bottom featured-project-section">
      <div class="container--wide">
        <div class="featured-project">
          <div class="featured-project__badge-bar">
            <span class="featured-label">FEATURED PROJECT</span>
            <span class="featured-service">{featuredStudy.service}</span>
          </div>

          <div class="featured-project__inner">
            <div class="featured-project__copy">
              <span class="featured-client">{featuredStudy.client}</span>
              <h2><a href={`/case-studies/${featuredStudy.slug}`}>{featuredStudy.title}</a></h2>
              <p class="featured-summary">{featuredStudy.summary || featuredStudy.challenge}</p>

              <div class="featured-highlights">
                <div class="highlight-item">
                  <span class="highlight-tag">The Challenge</span>
                  <p>{featuredStudy.challenge}</p>
                </div>
                <div class="highlight-item highlight-item--outcome">
                  <span class="highlight-tag">Delivered Outcome</span>
                  <p>{featuredStudy.outcome}</p>
                </div>
              </div>

              <div class="featured-action">
                <a class="button button--primary" href={`/case-studies/${featuredStudy.slug}`}>
                  Read full case study ↗
                </a>
              </div>
            </div>

            <div class="featured-project__visual" aria-hidden="true">
              <div class="visual-blueprint-frame">
                <div class="blueprint-frame__bar">
                  <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                  <span class="frame-title">nixwud.com/work/{featuredStudy.slug}</span>
                </div>
                <div class="blueprint-frame__content">
                  <div class="frame-tag">PRODUCTION LIVE</div>
                  <div class="frame-hero-mock">
                    <div class="mock-h"></div>
                    <div class="mock-p"></div>
                  </div>
                  <div class="frame-grid-mock">
                    <div class="mock-b"><span>ACCESSIBILITY: WCAG AA</span></div>
                    <div class="mock-b"><span>PERFORMANCE: 100/100</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Additional Selected Projects -->
  {otherStudies.length > 0 && (
    <section class="section border-bottom other-projects-section">
      <div class="container--wide">
        <div class="other-projects-header">
          <p class="eyebrow">More Selected Work</p>
          <h2>Custom applications, automation and search systems.</h2>
        </div>

        <div class="other-projects-grid">
          {otherStudies.map((study, index) => (
            <article class="project-card">
              <div class="project-card__top">
                <span class="project-card__num">0{index + 2}</span>
                <span class="project-card__service">{study.service}</span>
              </div>
              <div class="project-card__main">
                <span class="project-card__client">{study.client}</span>
                <h3>
                  <a href={`/case-studies/${study.slug}`}>{study.title}</a>
                </h3>
                <p class="project-card__summary">{study.summary || study.challenge}</p>

                <div class="project-card__body">
                  <div class="project-block">
                    <span class="project-block__label">Challenge</span>
                    <p>{study.challenge}</p>
                  </div>
                  <div class="project-block project-block--outcome">
                    <span class="project-block__label">Delivered Solution</span>
                    <p>{study.outcome}</p>
                  </div>
                </div>

                <div class="project-card__footer">
                  <a class="card__link" href={`/case-studies/${study.slug}`}>
                    View case study <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Standards Section -->
  <section class="section section--paper">
    <div class="container--wide">
      <header class="standards-header">
        <p class="eyebrow paper-eyebrow">Build Standards</p>
        <h2>What every Nixwud project delivers.</h2>
        <p class="lede">
          We hold every digital build, custom application and automation pipeline to strict technical and operational standards.
        </p>
      </header>

      <div class="standards-grid">
        {buildStandards.map((std) => (
          <div class="standard-card">
            <div class="standard-card__head">
              <span class="standard-num">{std.step}</span>
              <span class="standard-tag">{std.tag}</span>
            </div>
            <h3>{std.label}</h3>
            <p>{std.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA title="Have a project that needs building?" description="Share your goals and requirements. We will help you map out a practical, high-performance solution." />
</Layout>

<style>
  /* Featured Project */
  .featured-project-section {
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .featured-project {
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
  }

  .featured-project__badge-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .featured-label {
    color: var(--accent-soft);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-service {
    color: var(--text-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured-project__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 1fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .featured-client {
    display: block;
    color: var(--accent-soft);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .featured-project__copy h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 2.8vw, 2.5rem);
    line-height: var(--leading-h2);
  }

  .featured-project__copy h2 a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition);
  }

  .featured-project__copy h2 a:hover {
    color: var(--accent-soft);
  }

  .featured-summary {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: var(--leading-body);
    margin-bottom: 2rem;
  }

  .featured-highlights {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--line);
  }

  .highlight-item--outcome {
    border-left-color: var(--accent);
  }

  .highlight-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .highlight-item p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text);
  }

  .featured-action {
    margin-top: 1rem;
  }

  /* Visual Frame */
  .featured-project__visual {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.35);
  }

  .visual-blueprint-frame {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blueprint-frame__bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .blueprint-frame__bar .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line);
  }

  .frame-title {
    margin-left: 0.5rem;
    font-family: monospace;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .blueprint-frame__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-xs);
  }

  .frame-tag {
    display: inline-block;
    width: fit-content;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    background: rgba(115, 198, 159, 0.15);
    color: var(--positive);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .frame-hero-mock {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mock-h {
    width: 75%;
    height: 8px;
    background: var(--text);
    border-radius: 2px;
  }

  .mock-p {
    width: 50%;
    height: 6px;
    background: var(--line);
    border-radius: 2px;
  }

  .frame-grid-mock {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .mock-b {
    padding: 0.75rem;
    background: rgba(83, 109, 206, 0.1);
    border: 1px solid rgba(83, 109, 206, 0.25);
    border-radius: 2px;
  }

  .mock-b span {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--accent-soft);
    letter-spacing: 0.06em;
  }

  /* Other Projects */
  .other-projects-section {
    padding-block: clamp(4.5rem, 7vw, 7rem);
  }

  .other-projects-header {
    max-width: 44rem;
    margin-bottom: 3.5rem;
  }

  .other-projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .project-card {
    padding: clamp(2rem, 3.5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--ink-soft);
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition);
  }

  .project-card:hover {
    border-color: rgba(83, 109, 206, 0.45);
  }

  .project-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .project-card__num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-soft);
  }

  .project-card__service {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .project-card__client {
    display: block;
    color: var(--accent-soft);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .project-card h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.35rem, 1.8vw, 1.65rem);
    line-height: 1.3;
  }

  .project-card h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition);
  }

  .project-card h3 a:hover {
    color: var(--accent-soft);
  }

  .project-card__summary {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: var(--leading-body);
    margin-bottom: 1.5rem;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .project-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-block__label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .project-block p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .project-block--outcome p {
    color: var(--text);
  }

  .project-card__footer {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  /* Standards */
  .standards-header {
    max-width: 48rem;
    margin-bottom: 3.5rem;
  }

  .paper-eyebrow {
    color: var(--accent);
  }

  .standards-header h2 {
    max-width: 22ch;
    margin-bottom: 1rem;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .standard-card {
    padding: 1.75rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-sm);
    background: rgba(243, 241, 235, 0.7);
  }

  .standard-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .standard-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .standard-tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dark-muted);
  }

  .standard-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: var(--ink);
  }

  .standard-card p {
    margin: 0;
    color: var(--text-dark-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .featured-project__inner {
      grid-template-columns: 1fr;
    }

    .other-projects-grid {
      grid-template-columns: 1fr;
    }

    .standards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .standards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/sections/CTA.astro";
import { buildBreadcrumbSchema, getCanonicalUrl } from "../lib/seo.js";

const canonicalUrl = getCanonicalUrl("/about");
const breadcrumbs = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "About", url: "/about" }
]);

const principles = [
  {
    number: "01",
    title: "Understand before building",
    desc: "We take the time to understand your real operational workflows, user needs and business constraints before recommending or building software."
  },
  {
    number: "02",
    title: "Clarity over complexity",
    desc: "We avoid bloated frameworks and unnecessary technical jargon. We design straightforward interfaces and clean architectures that are easy to use."
  },
  {
    number: "03",
    title: "Fast, accessible and maintainable",
    desc: "Every website and application is engineered for rapid load times, WCAG accessibility standards and easy long-term maintenance by your internal team."
  },
  {
    number: "04",
    title: "Practical business outcomes",
    desc: "We evaluate our work by the real difference it makes: hours saved, smoother customer journeys, automated lead management and higher search traffic."
  },
  {
    number: "05",
    title: "Complete client ownership",
    desc: "You own your source code, design files, CMS schemas and integration accounts completely. No proprietary lock-in or artificial dependencies."
  },
  {
    number: "06",
    title: "Direct, transparent collaboration",
    desc: "You work directly with the designers and engineers building your system. No layers of account managers or vague status reports."
  }
];
---

<Layout
  title="About Nixwud"
  description="Learn about Nixwud, a digital development, design and business systems company that thinks carefully before it builds."
  canonical={canonicalUrl}
  structuredData={breadcrumbs}
>
  <header class="page-hero">
    <div class="container--wide">
      <p class="eyebrow">About Nixwud</p>
      <h1>A design and development company that thinks carefully before it builds.</h1>
      <p class="lede">
        We design and build websites, custom web applications, CRM workflows and search systems that help organisations work better and grow.
      </p>
    </div>
  </header>

  <!-- Core Proposition & Workshop Philosophy -->
  <section class="section border-bottom studio-ethos">
    <div class="container--wide">
      <p class="eyebrow">Our Philosophy</p>
      <h2 class="ethos-headline">We don't just build what you are asked for. We first work out what actually needs building.</h2>
      <div class="ethos-grid">
        <div class="ethos-narrative">
          <p class="lede">
            Many software projects fail or balloon in cost because development begins before the real business problem is understood.
          </p>
          <p>
            At Nixwud, we combine design craft, modern engineering and practical systems thinking. We examine how work moves through your organisation, identify bottlenecks and build digital solutions that fit your operational reality.
          </p>
        </div>

        <div class="ethos-disciplines" aria-label="Nixwud studio disciplines">
          <div class="discipline-box">
            <span class="d-tag">01. DESIGN</span>
            <strong>User Interfaces & Web Design</strong>
            <p>Clean, accessible and conversion-focused digital interfaces.</p>
          </div>
          <div class="discipline-box">
            <span class="d-tag">02. ENGINEERING</span>
            <strong>Web Apps & Custom Software</strong>
            <p>Fast, reliable web applications and internal operational tools.</p>
          </div>
          <div class="discipline-box">
            <span class="d-tag">03. SYSTEMS</span>
            <strong>CRM & Workflow Automation</strong>
            <p>Connected pipelines that eliminate repetitive manual handoffs.</p>
          </div>
          <div class="discipline-box discipline-box--accent">
            <span class="d-tag">04. DISCOVERY</span>
            <strong>Technical SEO & Search Architecture</strong>
            <p>Structured content systems for Google and AI search visibility.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Operating Principles -->
  <section class="section section--paper">
    <div class="container--wide">
      <header class="principles-header">
        <p class="eyebrow paper-eyebrow">Operating Principles</p>
        <h2>Six commitments that guide how we design and build.</h2>
        <p class="lede">These principles shape our engineering craft, project communication and long-term client partnerships.</p>
      </header>

      <div class="principles-bands">
        {principles.map((principle) => (
          <article class="principle-band">
            <span class="principle-band__num">{principle.number}</span>
            <div class="principle-band__content">
              <h3>{principle.title}</h3>
              <p>{principle.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Studio Craft Statement -->
  <section class="section border-bottom craft-section">
    <div class="container--narrow">
      <p class="eyebrow">Craft & Standards</p>
      <h2 class="craft-headline">Digital systems businesses can rely on for years to come.</h2>
      <p class="lede craft-lede">
        Our ambition is simple: build digital tools, websites and business systems that make your organisation genuinely easier to run, easier to discover and ready for growth.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .studio-ethos {
    padding-block: clamp(4.5rem, 7vw, 7rem);
    background-image: radial-gradient(circle at 10% 50%, rgba(83, 109, 206, 0.04) 0%, transparent 60%);
  }

  .ethos-headline {
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-weight: 600;
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-h2);
    max-width: 26ch;
    margin: 1rem 0 3rem;
  }

  .ethos-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .ethos-narrative p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: var(--leading-body);
  }

  .ethos-narrative .lede {
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .ethos-disciplines {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .discipline-box {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--ink-soft);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .discipline-box--accent {
    border-color: rgba(83, 109, 206, 0.35);
  }

  .d-tag {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
  }

  .discipline-box strong {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.25;
  }

  .discipline-box p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .principles-header {
    max-width: 48rem;
    margin-bottom: 3.5rem;
  }

  .paper-eyebrow {
    color: var(--accent);
  }

  .principles-header h2 {
    max-width: 24ch;
    margin-bottom: 1rem;
  }

  .principles-bands {
    display: flex;
    flex-direction: column;
  }

  .principle-band {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 2rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line-dark);
  }

  .principle-band:last-child {
    border-bottom: 1px solid var(--line-dark);
  }

  .principle-band__num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .principle-band__content h3 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.2rem, 1.4vw, 1.45rem);
    color: var(--ink);
  }

  .principle-band__content p {
    margin: 0;
    color: var(--text-dark-muted);
    font-size: 0.95rem;
    line-height: var(--leading-body);
    max-width: 42rem;
  }

  .craft-section {
    padding-block: clamp(5rem, 8vw, 8rem);
  }

  .craft-headline {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    max-width: 24ch;
    margin-bottom: 1.5rem;
  }

  .craft-lede {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .ethos-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .ethos-disciplines {
      grid-template-columns: 1fr;
    }

    .principle-band {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
